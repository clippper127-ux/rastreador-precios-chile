{
  "manifest_version": 3,
  "name": "Rastreador de precios",
  "description": "Sigue y actualiza precios de Falabella, Sodimac, Tottus, Paris, Ripley, Lider y PC Factory mientras navegas. Solo lee fichas y búsquedas de esas tiendas.",
  "version": "0.1.0",
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Rastreador de precios"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://rastreador-precios-chile.vercel.app/*",
    "http://localhost:3000/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.falabella.com/falabella-cl/*",
        "https://www.paris.cl/*",
        "https://simple.ripley.cl/*",
        "https://www.lider.cl/*",
        "https://www.sodimac.cl/sodimac-cl/*",
        "https://www.tottus.cl/tottus-cl/*",
        "https://www.pcfactory.cl/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
