# Copia este archivo a `.env` en la raíz del repo y completa los valores (lo leen web, worker y db).
# Nunca subas `.env` al repo. En GitHub Actions van como Secrets; en Vercel, como Environment Variables.

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# "Publishable key" (sb_publishable_...). La anon key antigua también funciona: NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret key" (sb_secret_...). Solo servidor. Fase 2 en adelante.
SUPABASE_SECRET_KEY=
# Muestra "Continuar con Google" en el login. Actívalo solo después de configurar el proveedor en Supabase.
AUTH_GOOGLE_ENABLED=false

# ─── Postgres (Drizzle) ───────────────────────────────────────────────────────
# Dashboard → Connect. Para la app y el worker: "Transaction pooler" (puerto 6543).
DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Para migraciones: "Session pooler" (puerto 5432) o conexión directa.
DATABASE_URL_MIGRATIONS=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# ─── Worker ───────────────────────────────────────────────────────────────────
# Healthchecks.io: URL del check (el worker hace ping en cada pasada). Fase 2.
HEALTHCHECK_URL=
# User-Agent honesto para las tiendas (opcional).
WORKER_USER_AGENT=

# ─── Mercado Libre (Fase 1) ───────────────────────────────────────────────────
# Registra una app gratis en developers.mercadolibre.cl.
ML_CLIENT_ID=
ML_CLIENT_SECRET=

# ─── Notificaciones (Fase 4) ──────────────────────────────────────────────────
# Crea el bot con @BotFather en Telegram.
TELEGRAM_BOT_TOKEN=
# Cuenta de Telegram DEDICADA para leer grupos que no aceptan bots (opcional).
# TG_API_ID y TG_API_HASH: https://my.telegram.org → API development tools. TG_SESSION: pnpm telegram:login
TG_API_ID=
TG_API_HASH=
TG_SESSION=
# Sin dominio verificado, Resend solo envía al correo de tu propia cuenta.
RESEND_API_KEY=
# Remitente. Sin dominio propio debe ser onboarding@resend.dev.
RESEND_FROM=Rastreador <onboarding@resend.dev>
# Dirección pública de la app (links en los avisos). En local: http://localhost:3000
APP_URL=http://localhost:3000

# ─── Errores ──────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ─── Opcionales: la app funciona completa sin ellas ──────────────────────────
# IA opcional: reconocer productos en fotos (Gemini, plan gratis de Google AI Studio: aistudio.google.com).
# Sin esto, la búsqueda por foto igual lee códigos de barras en el navegador.
LLM_API_KEY=
# Modelo con entrada de imagen. Los nombres y límites gratis cambian: confírmalo en AI Studio.
LLM_MODEL=gemini-flash-lite-latest
# Pricto (pricto.dev), solo supermercado/farmacia.
PRICTO_API_KEY=
